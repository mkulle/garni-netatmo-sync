# --- Tuya IoT Cloud (Garni 419T) ---
# Central Europe data center: https://openapi.tuyaeu.com
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
# DP code that carries the temperature (see `node src/main.ts --list`)
TUYA_TEMP_CODE=va_temperature
# Tuya reports temperature as an integer, 215 = 21.5 °C -> 10
TUYA_TEMP_SCALE=10

# --- Netatmo (same login as the mobile app) ---
NETATMO_USERNAME=
NETATMO_PASSWORD=
# Optional – when empty, the first home / first room with a module is used
NETATMO_HOME_ID=
NETATMO_ROOM_NAME=

# --- Behaviour ---
INTERVAL_SEC=300
# Calibrate only when the readings differ by at least this many °C
THRESHOLD=0.3
# Minimum gap between two calibrations
MIN_CALIBRATION_GAP_SEC=900
# A larger difference is suspicious, do not calibrate
MAX_DIFF=6
VALID_MIN=5
VALID_MAX=35
# 1 = log only, never write to Netatmo
DRY_RUN=1
# 1 = calibrate only when the thermostat regulates wrong: Garni is outside
#     setpoint ± TOLERANCE and Netatmo underestimates that error by at least THRESHOLD.
#     While Garni stays within the band, the displayed temperature is left alone.
CALIBRATE_ONLY_WHEN_WRONG=0
# Band around the setpoint (°C) in which regulation is considered correct
TOLERANCE=0.2
